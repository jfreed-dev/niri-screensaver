{
  // markdownlint-cli2 config — https://github.com/DavidAnson/markdownlint-cli2
  //
  // Pragmatic ruleset: enforce structural correctness (broken links,
  // missing code-fence languages, bare URLs) but leave prose style alone.
  "config": {
    "default": true,

    // Line length — prose isn't column-constrained; we hard-wrap by intent
    // in some places and overflow in others. Not worth gating PRs on.
    "MD013": false,

    // CHANGELOG has the same "### Added"/"### Fixed" subheadings across
    // multiple "## [version]" parents by convention. Keep the rule on for
    // sibling-level duplicates (real bugs) but allow same-named children
    // under different parents.
    "MD024": { "siblings_only": true },

    // Inline HTML is fine — README uses <kbd>, <details>, <br>, etc.
    "MD033": false,

    // First line need not be h1 — CHANGELOG starts with "# Changelog" but
    // the rule sometimes misfires on front-matter-less docs.
    "MD041": false,

    // Emphasis style mixed _italics_ and *italics* — pick neither, don't gate.
    "MD049": false,

    // Fences inside list items need indented continuation; the rule
    // prefers blank lines but that breaks the list. Allow tight fences
    // inside list items.
    "MD031": { "list_items": false }
  },
  "globs": ["**/*.md"],
  "ignores": [
    "node_modules/**",
    // Per-user Claude Code guidance; gitignored but may exist in working tree.
    "CLAUDE.md",
    // Third-party logo attributions; formatting follows upstream sources.
    "share/logos/LICENSES.md"
  ]
}
