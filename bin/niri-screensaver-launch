#!/bin/bash
# niri-screensaver-launch - Spawn fullscreen Alacritty window(s) running the screensaver
#
# Spawns one alacritty per output with --class niri-screensaver. Niri's window-rule
# (see docs/niri-window-rule.kdl) matches that app-id and applies open-fullscreen.
# For multi-monitor setups, focus-monitor-next is used to cycle outputs between spawns.
# SPDX-License-Identifier: GPL-3.0-only

set -uo pipefail

CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/niri-screensaver}"
PID_FILE="${CONFIG_DIR}/screensaver.pid"
TOGGLE_FILE="${CONFIG_DIR}/disabled"

# Resolve sibling assets: installed first, then dev-checkout fallback.
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
DATA_CANDIDATES=(
    "${NIRI_SCREENSAVER_DATA:-/usr/share/niri-screensaver}"
    "$HOME/.local/share/niri-screensaver"
    "${SCRIPT_DIR}/../share"
)

resolve_data_dir() {
    for d in "${DATA_CANDIDATES[@]}"; do
        if [[ -f "$d/alacritty-screensaver.toml" ]]; then
            echo "$d"
            return 0
        fi
    done
    return 1
}

DATA_DIR="$(resolve_data_dir || echo "${SCRIPT_DIR}/../share")"
ALACRITTY_CONFIG="${ALACRITTY_CONFIG:-${DATA_DIR}/alacritty-screensaver.toml}"

# The inner driver — installed alongside this launcher in the same bin dir.
SCREENSAVER_BIN="${SCREENSAVER_BIN:-${SCRIPT_DIR}/niri-screensaver}"

WINDOW_CLASS="niri-screensaver"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

log_info()    { echo -e "${CYAN}[INFO]${NC} $*"; }
log_success() { echo -e "${GREEN}[OK]${NC} $*"; }
log_warn()    { echo -e "${YELLOW}[WARN]${NC} $*"; }
log_error()   { echo -e "${RED}[ERROR]${NC} $*" >&2; }

is_disabled() { [[ -f "$TOGGLE_FILE" ]]; }

is_running() {
    if [[ -f "$PID_FILE" ]]; then
        local pid
        pid=$(cat "$PID_FILE" 2>/dev/null)
        if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
        rm -f "$PID_FILE"
    fi
    pgrep -f "alacritty .*--class[ =]${WINDOW_CLASS}" &>/dev/null
}

count_outputs() {
    if command -v niri &>/dev/null && command -v jq &>/dev/null; then
        niri msg --json outputs 2>/dev/null | jq -r 'keys | length' 2>/dev/null
    else
        echo 1
    fi
}

# Spawn alacritty via niri so it inherits the compositor environment cleanly.
spawn_one() {
    if command -v niri &>/dev/null; then
        niri msg action spawn -- alacritty \
            --class "$WINDOW_CLASS" \
            --config-file "$ALACRITTY_CONFIG" \
            -e "$SCREENSAVER_BIN" run
    else
        alacritty \
            --class "$WINDOW_CLASS" \
            --config-file "$ALACRITTY_CONFIG" \
            -e "$SCREENSAVER_BIN" run &
    fi
}

kill_screensaver() {
    if [[ -f "$PID_FILE" ]]; then
        rm -f "$PID_FILE"
    fi
    pkill -f "alacritty .*--class[ =]${WINDOW_CLASS}" 2>/dev/null
    pkill -f "$(basename "$SCREENSAVER_BIN") run" 2>/dev/null
    return 0
}

# Park the pointer in the bottom-right corner so it doesn't sit visible on top
# of the screensaver. Niri's cursor.hide-after-inactive-ms then hides it after
# the configured idle window. Tries wlrctl (wlr-virtual-pointer) first since
# it's daemonless under niri; falls back to ydotool. No-op + one-time hint if
# neither is installed.
warp_cursor_away() {
    if command -v wlrctl &>/dev/null; then
        wlrctl pointer move 1000000 1000000 2>/dev/null && return 0
    fi
    if command -v ydotool &>/dev/null; then
        ydotool mousemove --absolute 99999 99999 2>/dev/null && return 0
    fi
    log_info "Install wlrctl (or ydotool) to auto-park the pointer; or set 'cursor { hide-after-inactive-ms 500 }' in your niri config."
    return 1
}

launch_screensaver() {
    local force=""
    for arg in "$@"; do
        case "$arg" in
            force|-f|--force) force="force" ;;
        esac
    done

    if [[ "$force" != "force" ]] && is_disabled; then
        log_info "Screensaver disabled. Use 'niri-screensaver-ctl toggle' to enable."
        exit 0
    fi

    if [[ ! -x "$SCREENSAVER_BIN" ]]; then
        log_error "Inner driver not found or not executable: $SCREENSAVER_BIN"
        exit 1
    fi
    if [[ ! -f "$ALACRITTY_CONFIG" ]]; then
        log_error "Alacritty screensaver config not found: $ALACRITTY_CONFIG"
        exit 1
    fi

    if is_running; then
        kill_screensaver
        sleep 0.5
    fi

    mkdir -p "$CONFIG_DIR"
    echo $$ > "$PID_FILE"

    local count
    count=$(count_outputs)
    [[ -z "$count" || "$count" -lt 1 ]] && count=1

    log_info "Launching screensaver on $count output(s)..."

    spawn_one
    if [[ "$count" -gt 1 ]] && command -v niri &>/dev/null; then
        local i=1
        while [[ $i -lt $count ]]; do
            sleep 0.3
            niri msg action focus-monitor-next 2>/dev/null || true
            sleep 0.1
            spawn_one
            ((i++))
        done
    fi

    # Park the pointer after the last alacritty has had a moment to map.
    # Done before the inner driver enables mouse tracking, so the warp doesn't
    # generate motion events that would falsely dismiss the screensaver.
    sleep 0.2
    warp_cursor_away || true
}

toggle_screensaver() {
    if is_disabled; then
        rm -f "$TOGGLE_FILE"
        log_success "Screensaver enabled"
        notify-send "Screensaver" "Enabled" 2>/dev/null || true
    else
        mkdir -p "$(dirname "$TOGGLE_FILE")"
        touch "$TOGGLE_FILE"
        log_success "Screensaver disabled"
        notify-send "Screensaver" "Disabled" 2>/dev/null || true
    fi
}

show_status() {
    echo
    echo "niri-screensaver status"
    echo "──────────────────────────────"
    if is_running; then
        echo -e "Running:    ${GREEN}yes${NC}"
    else
        echo -e "Running:    ${RED}no${NC}"
    fi
    if is_disabled; then
        echo -e "Enabled:    ${RED}no${NC} (toggle file present)"
    else
        echo -e "Enabled:    ${GREEN}yes${NC}"
    fi
    echo -e "Outputs:    $(count_outputs)"
    echo -e "Driver:     $SCREENSAVER_BIN"
    echo -e "Alacritty:  $ALACRITTY_CONFIG"
    echo -e "Class:      $WINDOW_CLASS"
    echo
}

usage() {
    cat << EOF
Usage: $(basename "$0") [COMMAND]

Spawn the niri-screensaver in fullscreen Alacritty windows.

Commands:
    launch [force]   Launch the screensaver (default; 'force' overrides toggle)
    kill             Stop running screensaver
    toggle           Toggle screensaver enabled/disabled
    status           Show status
    help             Show this help

Environment:
    CONFIG_DIR           Config directory (default: ~/.config/niri-screensaver)
    NIRI_SCREENSAVER_DATA  Override data dir (alacritty config + logos)
    ALACRITTY_CONFIG     Alacritty config file (default: <data>/alacritty-screensaver.toml)
    SCREENSAVER_BIN      Path to inner driver (default: sibling 'niri-screensaver')
EOF
}

main() {
    local cmd="${1:-launch}"
    shift 2>/dev/null || true
    case "$cmd" in
        launch|run|start) launch_screensaver "$@" ;;
        kill|stop)        kill_screensaver; log_success "Screensaver stopped" ;;
        toggle)           toggle_screensaver ;;
        status)           show_status ;;
        help|-h|--help)   usage ;;
        *) log_error "Unknown command: $cmd"; usage; exit 1 ;;
    esac
}

main "$@"
