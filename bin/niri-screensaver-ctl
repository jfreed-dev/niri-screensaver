#!/bin/bash
# niri-screensaver-ctl - Thin shim over niri-screensaver-launch + niri-screensaver
#
# Forwards launch/kill/toggle/status to the launcher and test/preview/effects to the driver.
# Provided for symmetry with cosmic-order's screensaver-ctl, minus the
# swayidle/systemd/lock-command plumbing (Noctalia owns those concerns).
# SPDX-License-Identifier: GPL-3.0-only

set -uo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
LAUNCHER="${SCRIPT_DIR}/niri-screensaver-launch"
DRIVER="${SCRIPT_DIR}/niri-screensaver"

usage() {
    cat << EOF
Usage: $(basename "$0") <command> [args]

Commands:
    launch [force]   Start the screensaver now
    kill             Stop the running screensaver
    toggle           Toggle the disabled flag
    status           Show running/enabled/output state
    is-running       Exit 0 if running, 1 if not (quiet; for scripts/widgets)
    test [EFFECT]    Run a single TTE effect (random if omitted)
    preview EFFECT   Preview a single named TTE effect inline
    effects          List all TTE effects
    setup            Create config dir and copy default logo
    help             Show this help

Configuration lives in ~/.config/niri-screensaver/config (sourced as shell).
Idle, lock, and DPMS are owned by Noctalia — not this tool.
EOF
}

cmd="${1:-help}"
shift 2>/dev/null || true

case "$cmd" in
    launch|kill|toggle|status|is-running) exec "$LAUNCHER" "$cmd" "$@" ;;
    test|preview|effects|setup)    exec "$DRIVER" "$cmd" "$@" ;;
    help|-h|--help)            usage ;;
    *) echo "Unknown command: $cmd" >&2; usage; exit 1 ;;
esac
