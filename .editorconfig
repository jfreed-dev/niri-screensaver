root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{qml,json,kdl,toml}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false   # allow markdown hard-breaks (two trailing spaces)

[Makefile]
indent_style = tab

[share/logos/*.txt]
trim_trailing_whitespace = false   # logos are pixel-art; trailing spaces are content
